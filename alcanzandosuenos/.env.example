# Copiar a `.env` (no se sube al repo, ver .gitignore) y completar con los
# valores del proyecto de Supabase. Expo solo expone al bundle las variables
# que empiezan con EXPO_PUBLIC_ — por diseño, así que estas SÍ terminan en el
# código de la app (son públicas: la "anon key" está pensada para eso).

# Supabase → Project Settings → API → Project URL / anon public key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL del backend (NestJS). En local con Expo web, localhost sirve tal cual.
# En un dispositivo físico o una vez desplegado, apuntar a la URL pública
# (ver Pendientes de PROYECTO.md: Railway/Render).
EXPO_PUBLIC_API_URL=http://localhost:3000
