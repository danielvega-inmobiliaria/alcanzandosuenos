# Copiar a `.env` (no se sube al repo, ver .gitignore) y completar con los
# valores reales del proyecto de Supabase (o de la base local).

# --- Auth (obligatorio para que el backend arranque a validar sesiones) ---
# Supabase → Project Settings → API → JWT Settings → "JWT Secret"
SUPABASE_JWT_SECRET=

# --- Base de datos: opción A (recomendada) — Postgres gestionado ---
# Supabase → Project Settings → Database → Connection string → "URI"
# (usar el modo "Transaction" o "Session pooling" según el hosting del backend)
DATABASE_URL=

# --- Base de datos: opción B — Postgres local (si no seteás DATABASE_URL) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=alcanzandosuenos

# --- Servidor ---
PORT=3000
